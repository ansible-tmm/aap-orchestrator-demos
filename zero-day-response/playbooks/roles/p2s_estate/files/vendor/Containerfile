# AcmeCMS 5.2 appliance: upstream PHP 8.1 EOL; vendor rebuild delay is simulated.
FROM docker.io/library/php:8.1.34-apache@sha256:72f0c0134922985022d55a39b0390d35dc7a10e961aa6c44fa35b4c3102f4268
COPY app/ /var/www/html/
ENV P2S_SERVICE=acme-cms
LABEL vendor="AcmeCMS" version="5.2" com.example.bundled-php="upstream-8.1-eol"
EXPOSE 80
