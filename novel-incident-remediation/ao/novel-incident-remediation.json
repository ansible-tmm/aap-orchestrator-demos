          "ticket_id": "${trigger.ticket_id}",
          "target_host": "${trigger.host}",
          "incident_type": "${trigger.incident_type}"
        },
        "credential_id": "YOUR_AO_AAP_CREDENTIAL_ID",
        "integration_id": "YOUR_AAP_INTEGRATION_ID",
        "job_template_name": "Incidents | Impact Report",
        "organization_name": "Default"
      },
      "position": {
        "x": 577.783968986604,
        "y": 51.55042569681383
      }
    },
    {
      "id": "impact_report_config",
      "type": "aap_job_template",
      "name": "Generate Impact Report - Config Drift",
      "parameters": {
        "extra_vars": {
          "ticket_id": "${trigger.ticket_id}",
          "target_host": "${trigger.host}",
          "incident_type": "${trigger.incident_type}"
        },
        "credential_id": "YOUR_AO_AAP_CREDENTIAL_ID",
        "integration_id": "YOUR_AAP_INTEGRATION_ID",
        "job_template_name": "Incidents | Impact Report",
        "organization_name": "Default"
      },
      "position": {
        "x": 602.6703813919625,
        "y": 321.77760088609705
      }
    },
    {
      "id": "investigate_agent",
      "type": "agentic",
      "name": "AI - Troubleshoot & Collect",
      "parameters": {
        "prompt": "Analyze this incident. Cite specific numbers. Output JSON only.\n\nIncident: ${trigger.description}\nHost: ${trigger.host} | Ticket: ${trigger.ticket_id} | Severity: ${trigger.severity}\n\nSYSTEM STATE:\n- Memory: ${gather_facts.artifacts.memory_used_pct}% used (${gather_facts.artifacts.memory_free_mb}MB free of ${gather_facts.artifacts.memory_total_mb}MB)\n- Root filesystem: ${gather_facts.artifacts.disk_root_pct}% used (${gather_facts.artifacts.disk_root_avail} free)\n- App session storage (/var/log/app-sessions): ${gather_facts.artifacts.disk_varlog_pct}% FULL \u2014 this is where applications write session data\n- Failed services: ${gather_facts.artifacts.failed_unit_count} (${gather_facts.artifacts.failed_units})\n- Web service check: ${gather_facts.artifacts.web_check}\n- Active connections: ${gather_facts.artifacts.active_connections}\n- Top process: ${gather_facts.artifacts.top_process}\n- Recent errors (from syslog): ${gather_facts.artifacts.recent_errors}\n\nIMPORTANT: The app session storage percentage is the critical metric \u2014 if it is 100%, application writes are failing which directly causes HTTP 500 errors.\n\nOutput ONLY this JSON:\n{\"summary\":\"\",\"host_environment\":\"\",\"host_criticality\":\"\",\"recent_failures\":\"\",\"root_cause_hypothesis\":\"cite the session storage % specifically\",\"affected_services\":\"\",\"recommended_ansible_module\":\"\",\"troubleshooting_findings\":\"2 sentences citing the session storage % and its effect on services\"}",
        "llm_model_id": "YOUR_AO_LLM_MODEL_ID",
        "credential_id": "YOUR_AO_MODEL_CREDENTIAL_ID",
        "response_schema": {
          "type": "object",
          "required": [
            "summary",
            "root_cause_hypothesis",
            "troubleshooting_findings"
          ],
          "properties": {
            "summary": {
              "type": "string"
            },
            "recent_failures": {
              "type": "string"
            },
            "host_criticality": {
              "type": "string"
            },
            "host_environment": {
              "type": "string"
            },
            "affected_services": {
              "type": "string"
            },
            "root_cause_hypothesis": {
              "type": "string"
            },
            "troubleshooting_findings": {
              "type": "string"
            },
            "recommended_ansible_module": {
              "type": "string"
            }
          }
        },
        "tool_selection_strategy": "NONE"
      },
      "position": {
        "x": 649.8328863656968,
        "y": 949.6085091138324
      }
    },
    {
      "id": "enrich_snow_ticket",
      "type": "aap_job_template",
      "name": "Enrich SNOW ticket - AI Findings",
      "parameters": {
        "diff_mode": false,
        "extra_vars": {
          "ticket_id": "${trigger.ticket_id}",
          "target_host": "${trigger.host}",
          "notification_body": "Root Cause: ${investigate_agent.result.content.root_cause_hypothesis}\n\nFindings: ${investigate_agent.result.content.troubleshooting_findings}\n\nAffected Services: ${investigate_agent.result.content.affected_services}",
          "snow_ticket_state": "2",
          "notification_title": "AI Troubleshooting - Findings"
        },
        "credential_id": "YOUR_AO_AAP_CREDENTIAL_ID",
        "integration_id": "YOUR_AAP_INTEGRATION_ID",
        "job_template_name": "Incidents | Update Ticket",
        "organization_name": "Default"
      },
      "position": {
        "x": 1053.5307742793652,
        "y": 929.6567015547247
      }
    },
