{
  "schema_version": "2.0.0",
  "name": "Novel Incident Remediation",
  "description": "Known incident types (disk, service, config) route directly to existing AAP job templates. Unknown or unclassified incidents trigger an AI agent that investigates using system facts, enriches the ServiceNow ticket with findings, then generates a remediation plan with automation recommendations for operator approval and execution.",
  "triggers": [
    {
      "id": "snow_trigger",
      "type": "webhook_trigger",
      "name": "ServiceNow Incident",
      "parameters": {
        "input_schema": {
          "type": "object",
          "$schema": "http://json-schema.org/draft-07/schema#",
          "required": [
            "ticket_id",
            "incident_type",
            "host"
          ],
          "properties": {
            "host": {
              "type": "string",
              "default": "node1",
              "description": "Affected hostname"
            },
            "severity": {
              "type": "string",
              "default": "2-High",
              "description": "1-Critical 2-High 3-Medium 4-Low"
            },
            "ticket_id": {
              "type": "string",
              "default": "INC0012345",
              "description": "ServiceNow incident number"
            },
            "description": {
              "type": "string",
              "default": "Intermittent application errors. Users cannot complete transactions. Root cause unknown.",
              "description": "Incident description from SNOW"
            },
            "incident_type": {
              "type": "string",
              "default": "service_down",
              "description": "service_down | config_drift | capacity_issue | unknown"
            }
          }
        },
        "webhook_path": "novel-incident-remediation",
        "authorized_service_account_ids": []
      },
      "position": {
        "x": -120,
        "y": 450
      }
    }
  ],
  "nodes": [
    {
