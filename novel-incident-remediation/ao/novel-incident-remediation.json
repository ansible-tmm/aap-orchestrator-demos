          "notification_title": "Capacity Issue - Remediated"
        },
        "credential_id": "YOUR_AO_AAP_CREDENTIAL_ID",
        "integration_id": "YOUR_AAP_INTEGRATION_ID",
        "job_template_name": "Incidents | Update Ticket",
        "organization_name": "Default"
      },
      "position": {
        "x": 935.6750900589636,
        "y": 587.6204526439781
      }
    },
    {
      "id": "notify_config_resolved",
      "type": "aap_job_template",
      "name": "Post to SNOW - Escalate to Change Mgmt",
      "parameters": {
        "extra_vars": {
          "ticket_id": "${trigger.ticket_id}",
          "target_host": "${trigger.host}",
          "notification_body": "Host: ${trigger.host} | Ticket: ${trigger.ticket_id}. Configuration drift on production system escalated to change management. No automated action taken.",
          "snow_ticket_state": "3",
          "notification_title": "Config Drift - Escalated"
        },
        "credential_id": "YOUR_AO_AAP_CREDENTIAL_ID",
        "integration_id": "YOUR_AAP_INTEGRATION_ID",
        "job_template_name": "Incidents | Update Ticket",
