        "credential_id": "YOUR_AO_AAP_CREDENTIAL_ID",
        "integration_id": "YOUR_AAP_INTEGRATION_ID",
        "job_template_name": "Incidents | Capacity - Disk Cleanup",
        "organization_name": "Default"
      },
      "position": {
        "x": 605.1336891303691,
        "y": 587.5567937973208
      }
    },
