    {
      "id": "close_ticket",
      "type": "aap_job_template",
      "name": "Close Ticket - Remediation Complete",
      "parameters": {
        "extra_vars": {
          "ticket_id": "${trigger.ticket_id}",
          "target_host": "${trigger.host}",
          "notification_body": "Automation: ${planning_agent.result.content.recommended_job_template}\n\nService Restoration:\n- API Gateway API: RESTORED (${run_recommended_job.artifacts.web_check_after})\n- Session Management: RESTORED (storage freed, writes resuming)\n- New disk errors since fix: ${run_recommended_job.artifacts.disk_errors_remaining}\n\nRemediation Results:\n- Disk: ${run_recommended_job.artifacts.disk_before} \u2192 ${run_recommended_job.artifacts.disk_after} (freed ${run_recommended_job.artifacts.mb_freed}MB)\n- ${run_recommended_job.artifacts.large_files_removed} large log files removed\n\nTicket ${trigger.ticket_id} closed. All services operational.",
          "snow_ticket_state": "6",
          "notification_title": "Incident RESOLVED - ${trigger.ticket_id}"
        },
        "credential_id": "YOUR_AO_AAP_CREDENTIAL_ID",
        "integration_id": "YOUR_AAP_INTEGRATION_ID",
        "job_template_name": "Incidents | Update Ticket",
        "organization_name": "Default"
      },
      "position": {
        "x": 2791.959947936363,
